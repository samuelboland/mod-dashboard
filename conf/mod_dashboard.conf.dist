[worldserver]

########################################
# mod-dashboard configuration
########################################
#
# Bot dashboard: world-thread snapshot of online characters served over HTTP.
# Reads (open): / (web page), /bots, /worldmap, /health, /commands, /maps/.
# Writes (token): POST /cmd/pause, POST /cmd/resume with {"guid": N} and header
# X-Dashboard-Token. Commands run on the world thread.
# Never bind a public interface: localhost and the tailnet address only.

# Dashboard.Enable
#     Description: Start the HTTP server and build snapshots.
#     Default:     1 (true)
Dashboard.Enable = 1

# Dashboard.Bind
#     Description: Comma-separated addresses to listen on. Read at startup only.
#                  Example: 127.0.0.1,10.0.0.5
#     Default:     127.0.0.1
Dashboard.Bind = 127.0.0.1

# Dashboard.Port
#     Description: TCP port. Read at startup only.
#     Default:     8787
Dashboard.Port = 8787

# Dashboard.SnapshotIntervalMs
#     Description: How often the world thread rebuilds the /bots snapshot.
#     Default:     2000
Dashboard.SnapshotIntervalMs = 2000

# Dashboard.WebRoot
#     Description: Directory served at /. Edits to the page need no restart.
#     Default:     <SourceDirectory>/modules/mod-dashboard/web
#                  Leave it unset unless the web/ folder was moved away from the module.
Dashboard.WebRoot =

# Dashboard.CommandToken
#     Description: Shared secret for POST /cmd/*, sent as the X-Dashboard-Token
#                  header. Empty turns commands off. At least 16 characters.
#                  Generate one with: openssl rand -hex 24
#     Default:     "" (commands off)
Dashboard.CommandToken = ""

# Dashboard.Settings.Keys
#     Description: Comma-separated config keys the page's Settings panel shows,
#                  with their current values (GET /settings). Only these keys
#                  can be changed from the page. Empty turns the panel off.
#                  Example: OllamaChat.Conversation.Enable,OllamaChat.Delivery.Split
#     Default:     "" (off)
Dashboard.Settings.Keys = ""

# Dashboard.Settings.File
#     Description: The config file those keys are written to when changed from
#                  the page (POST /cmd/setting, which needs the command token).
#                  A relative path is found beside worldserver.conf, e.g.
#                  modules/mod_ollama_chat.conf. One backup is kept beside it as
#                  <file>.dashboard.bak. Empty leaves the panel read-only. If your
#                  config files are generated from another source, record the
#                  change there too, or the next regeneration undoes it.
#     Default:     "" (read-only)
Dashboard.Settings.File = ""

# Dashboard.Settings.ReloadCommand
#     Description: Console command queued after a change, so it takes effect
#                  without a restart, e.g. "ollama reload". Empty: the change
#                  waits for the next reload or restart.
#     Default:     ""
Dashboard.Settings.ReloadCommand = ""

# Dashboard.PauseTeleportHoldSec
#     Description: On pause, the random-bot teleport timer is pushed this far out
#                  so the bot is not moved away. Resume reschedules it normally.
#     Default:     86400
Dashboard.PauseTeleportHoldSec = 86400

# Dashboard.MapRoot
#     Description: Directory of world map PNGs + manifest.json, served at /maps/.
#                  Blizzard-derived: keep it outside any repository.
#     Default:     <DataDir>/dashboard-maps
Dashboard.MapRoot =
