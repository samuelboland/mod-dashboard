[worldserver]

########################################
# mod-dashboard configuration
########################################
#
# Bot dashboard: world-thread snapshot of online characters served over HTTP.
# Reads (open): / (web page), /bots, /worldmap, /health, /commands, /maps/.
# Writes (token): POST /cmd/pause, POST /cmd/resume with {"guid": N} and header
# X-Dashboard-Token. Commands run on the world thread.
# Never bind a public interface: localhost and the tailnet address only.

# Dashboard.Enable
#     Description: Start the HTTP server and build snapshots.
#     Default:     1 (true)
Dashboard.Enable = 1

# Dashboard.Bind
#     Description: Comma-separated addresses to listen on. Read at startup only.
#                  Example: 127.0.0.1,10.0.0.5
#     Default:     127.0.0.1
Dashboard.Bind = 127.0.0.1

# Dashboard.Port
#     Description: TCP port. Read at startup only.
#     Default:     8787
Dashboard.Port = 8787

# Dashboard.SnapshotIntervalMs
#     Description: How often the world thread rebuilds the /bots snapshot.
#     Default:     2000
Dashboard.SnapshotIntervalMs = 2000

# Dashboard.WebRoot
#     Description: Directory served at /. Edits to the page need no restart.
#     Default:     <SourceDirectory>/modules/mod-dashboard/web
#                  Leave it blank unless the web/ folder was moved away from the module.
Dashboard.WebRoot =

# Dashboard.CommandToken
#     Description: Shared secret for POST /cmd/*, sent as the X-Dashboard-Token
#                  header. Empty turns commands off. At least 16 characters.
#                  Generate one with: openssl rand -hex 24
#     Default:     "" (commands off)
Dashboard.CommandToken = ""

# Dashboard.Settings.Keys
#     Description: Comma-separated config keys the page's Settings panel shows,
#                  with their current values (GET /settings). Only these keys
#                  can be changed from the page. Empty turns the panel off.
#                  Example: OllamaChat.Conversation.Enable,OllamaChat.Delivery.Split
#     Default:     "" (off)
Dashboard.Settings.Keys = ""

# Dashboard.Settings.File
#     Description: The config file those keys are written to when changed from
#                  the page (POST /cmd/setting, which needs the command token).
#                  A relative path is found beside worldserver.conf, e.g.
#                  modules/mod_ollama_chat.conf. One backup is kept beside it as
#                  <file>.dashboard.bak. Empty leaves the panel read-only. If your
#                  config files are generated from another source, record the
#                  change there too, or the next regeneration undoes it.
#     Default:     "" (read-only)
Dashboard.Settings.File = ""

# Dashboard.Settings.ReloadCommand
#     Description: Console command queued after a change, so it takes effect
#                  without a restart, e.g. "ollama reload". Empty: the change
#                  waits for the next reload or restart.
#     Default:     ""
Dashboard.Settings.ReloadCommand = ""

# Optional named groups for settings stored in different module files. Group
# names contain letters, digits or underscores. A key must belong to only one
# group; ambiguous keys are excluded. The legacy Keys/File/ReloadCommand above
# remains supported. Keep groups empty to leave all settings disabled.
# Configure only keys supported by your installed modules. Never expose secrets.
# Example (requires the conversation and persistent-progression module changes):
# Dashboard.Settings.Groups = chat,playerbots
# Dashboard.Settings.chat.Keys = OllamaChat.Conversation.Enable,OllamaChat.Conversation.HoldSeconds,OllamaChat.Conversation.HoldStill,OllamaChat.Delivery.Split,OllamaChat.Reply.Model
# Dashboard.Settings.chat.Types = OllamaChat.Reply.Model:text
#   (OllamaChat.Reply.Model names the model, or a router route, that answers a real player; see MODELS.md)
# Dashboard.Settings.chat.File = modules/mod_ollama_chat.conf
# Dashboard.Settings.chat.ReloadCommand = ollama reload
# Dashboard.Settings.playerbots.Keys = AiPlayerbot.PersistentProgression,AiPlayerbot.PersistentProgression.AnchorOnMeeting,AiPlayerbot.PersistentProgression.FollowGap,AiPlayerbot.PersistentProgression.AnchorInterval,AiPlayerbot.LevelBrackets.Enabled,AiPlayerbot.ResetBotLevel.Enabled
# Dashboard.Settings.playerbots.File = modules/playerbots.conf
# Dashboard.Settings.playerbots.ReloadCommand = reload config
# A blank ReloadCommand saves without activating; the panel shows the pending value.
Dashboard.Settings.Groups = ""

# Dashboard.Settings.<group>.Types (or Dashboard.Settings.Types for a single file)
#     Optional comma-separated Key:type[:min[:max]] rules checked in C++ before saving.
#     Types: bool, int, number (finite decimals), text. Invalid/duplicate rules exclude the key.
#     Without a rule, numeric and boolean active values must keep their inferred type.
#     Set explicit bool rules for 0/1 switches; otherwise numeric values infer as integers.
#     Example: AiPlayerbot.PersistentProgression:int:0:2,AiPlayerbot.ResetBotLevel.Enabled:bool
#     Example: OllamaChat.Conversation.HoldSeconds:int:10:3600,OllamaChat.Conversation.MaxDistance:number:5:100
#     Dashboard.* keys and names containing Token, Password, Secret, ApiKey or DatabaseInfo
#     (a database password) are always rejected, case-insensitively. They cannot be exposed or made writable through an allowlist.
Dashboard.Settings.Types = ""

# Dashboard.PauseTeleportHoldSec
#     Description: On pause, the random-bot teleport timer is pushed this far out
#                  so the bot is not moved away. Resume reschedules it normally.
#     Default:     86400
Dashboard.PauseTeleportHoldSec = 86400

# Dashboard.MapRoot
#     Description: Directory of world map PNGs + manifest.json, served at /maps/.
#                  Blizzard-derived: keep it outside any repository.
#     Default:     <DataDir>/dashboard-maps (when blank)
Dashboard.MapRoot =
